# Everything below is regenerated by Unity or the IDE. A fresh clone opens in
# Unity 2022.3.19f1 with no extra installs: packages resolve from
# Packages/manifest.json, and DOTween, TMP Essentials and all settings are committed.

# Unity-generated folders (anchored to the project root)
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Build outputs
*.apk
*.aab
*.unitypackage
*_BurstDebugInformation_DoNotShip/
crashlytics-build.properties

# Debug symbols and Unity crash info (DOTween's own .mdb files stay committed)
*.pdb
*.pdb.meta
*.opendb
*.VC.db
sysinfo.txt

# IDE files (Unity regenerates the project files)
.vs/
.idea/
.vscode/
.gradle/
*.csproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.unityproj
*.tmp

# Operating system
.DS_Store
Thumbs.db
Desktop.ini

# Python (Docs/reference simulator)
__pycache__/
*.pyc
